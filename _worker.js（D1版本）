const ONLINE_CODES = [200, 301, 302, 403, 404, 502, 521, 522];

// 数据库自动建表防护
async function initDatabase(db) {
  if (!db) return;
  try {
    await db.batch([
      db.prepare(`CREATE TABLE IF NOT EXISTS tunnels_config (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        name TEXT UNIQUE,
        domain TEXT,
        created_at INTEGER
      )`),
      db.prepare(`CREATE TABLE IF NOT EXISTS tunnel_status (
        name TEXT PRIMARY KEY,
        domain TEXT,
        online INTEGER,
        status_code INTEGER,
        timestamp INTEGER
      )`),
      db.prepare(`CREATE TABLE IF NOT EXISTS tunnel_history (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        name TEXT,
        online INTEGER,
        duration INTEGER,
        timestamp INTEGER
      )`),
      db.prepare(`CREATE TABLE IF NOT EXISTS tunnel_notify (
        name TEXT PRIMARY KEY,
        status TEXT
      )`),
      db.prepare(`CREATE INDEX IF NOT EXISTS idx_history_name_time ON tunnel_history(name, timestamp)`)
    ]);
  } catch (e) {
    console.error("数据库初始化异常", e);
  }
}

function getArgoEnv(env) {
  if (!env) return "";
  for (const key of Object.keys(env)) {
    if (key.toLowerCase() === "argo") {
      return env[key] || "";
    }
  }
  return "";
}

function getConfig(env) {
  return {
    ARGO: getArgoEnv(env), 
    BOT_TOKEN: env.BOT_TOKEN || "",
    CHAT_ID: env.CHAT_ID || "",
    ADMIN_PASS: env.ADMIN_PASS || "admin123"
  };
}

function getBeijingTimeString(ts = Date.now()) {
  return new Intl.DateTimeFormat("zh-CN", {
    timeZone: "Asia/Shanghai",
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    hour: "2-digit",
    minute: "2-digit",
    second: "2-digit",
    hour12: false
  }).format(new Date(ts));
}

function parseArgoConfig(text) {
  if (!text) return [];
  return text
    .split(/[\n;]/)
    .map(v => v.trim())
    .filter(Boolean)
    .map(line => {
      const parts = line.split("-----");
      return {
        name: parts[0]?.trim(),
        domain: parts[1]?.trim(),
        isEnv: true
      };
    })
    .filter(v => v.name && v.domain);
}

async function getMergedTunnels(env) {
  const envTunnels = parseArgoConfig(getArgoEnv(env));
  const envNames = new Set(envTunnels.map(t => t.name));

  const d1Tunnels = [];
  if (env.DB) {
    try {
      const { results } = await env.DB.prepare(`SELECT id, name, domain FROM tunnels_config ORDER BY id ASC`).all();
      if (results) {
        results.forEach(item => {
          if (!envNames.has(item.name)) {
            d1Tunnels.push({ name: item.name, domain: item.domain, isEnv: false });
          }
        });
      }
    } catch (e) {
      console.error("D1 配置读取避险捕获", e);
    }
  }

  return [...envTunnels, ...d1Tunnels];
}

async function sendTelegram(env, message) {
  if (!env.BOT_TOKEN || !env.CHAT_ID) return false;
  try {
    const url = `https://api.telegram.org/bot${env.BOT_TOKEN}/sendMessage`;
    const resp = await fetch(url, {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({
        chat_id: env.CHAT_ID,
        text: message,
        parse_mode: "HTML"
      })
    });
    const data = await resp.json();
    return data.ok;
  } catch (e) {
    console.error(e);
    return false;
  }
}

async function checkTunnel(domain) {
  try {
    const resp = await fetch(`https://${domain}`, {
      method: "GET",
      redirect: "manual",
      headers: { "User-Agent": "TunnelMonitor/6.4" }
    });
    return {
      online: ONLINE_CODES.includes(resp.status),
      statusCode: resp.status,
      timestamp: Date.now()
    };
  } catch (e) {
    return {
      online: false,
      statusCode: 0,
      error: e.message,
      timestamp: Date.now()
    };
  }
}

async function processTunnel(env, db, tunnel) {
  const result = await checkTunnel(tunnel.domain);
  const onlineInt = result.online ? 1 : 0;
  const now = Date.now();

  await db.prepare(`
    INSERT INTO tunnel_status (name, domain, online, status_code, timestamp)
    VALUES (?, ?, ?, ?, ?)
    ON CONFLICT(name) DO UPDATE SET
      domain=excluded.domain,
      online=excluded.online,
      status_code=excluded.status_code,
      timestamp=excluded.timestamp
  `).bind(tunnel.name, tunnel.domain, onlineInt, result.statusCode, now).run();

  await db.prepare(`
    INSERT INTO tunnel_history (name, online, duration, timestamp) VALUES (?, ?, 60, ?)
  `).bind(tunnel.name, onlineInt, now).run();

  const thirtyDaysAgo = now - 30 * 24 * 60 * 60 * 1000;
  await db.prepare(`DELETE FROM tunnel_history WHERE timestamp < ?`).bind(thirtyDaysAgo).run();

  const notifyRow = await db.prepare(`SELECT status FROM tunnel_notify WHERE name = ?`).bind(tunnel.name).first();
  const notified = notifyRow ? notifyRow.status : null;

  if (!result.online && notified !== "offline") {
    await sendTelegram(env, `❌ <b>${tunnel.name} 离线告警</b>\n\n🌐 域名：<code>${tunnel.domain}</code>\nHTTP 状态：<code>${result.statusCode || "连接超时/失败"}</code>\n发生时间：${getBeijingTimeString(now)}`);
    await db.prepare(`INSERT INTO tunnel_notify (name, status) VALUES (?, 'offline') ON CONFLICT(name) DO UPDATE SET status='offline'`).bind(tunnel.name).run();
  }

  if (result.online && notified === "offline") {
    await sendTelegram(env, `✅ <b>${tunnel.name} 恢复运行</b>\n\n🌐 域名：<code>${tunnel.domain}</code>\nHTTP 状态：<code>${result.statusCode}</code>\n恢复时间：${getBeijingTimeString(now)}`);
    await db.prepare(`INSERT INTO tunnel_notify (name, status) VALUES (?, 'online') ON CONFLICT(name) DO UPDATE SET status='online'`).bind(tunnel.name).run();
  }
}

async function computeMetrics(db, name, isCurrentlyOnline) {
  const now = Date.now();
  let healthyText = "0天0小时";
  let offlineDurationText = "0分钟";
  let isZeroMinOffline = false;

  try {
    if (isCurrentlyOnline) {
      const lastOffline = await db.prepare(`
        SELECT timestamp FROM tunnel_history 
        WHERE name = ? AND online = 0 
        ORDER BY timestamp DESC LIMIT 1
      `).bind(name).first();

      let uptimeStart = lastOffline ? lastOffline.timestamp : (now - 30 * 24 * 3600 * 1000);
      const firstRecord = await db.prepare(`
        SELECT timestamp FROM tunnel_history WHERE name = ? ORDER BY timestamp ASC LIMIT 1
      `).bind(name).first();
      
      if (firstRecord && firstRecord.timestamp > uptimeStart) {
        uptimeStart = firstRecord.timestamp;
      }

      const diffMs = Math.max(0, now - uptimeStart);
      const totalHours = Math.floor(diffMs / (1000 * 60 * 60));
      const days = Math.floor(totalHours / 24);
      const hours = totalHours % 24;
      healthyText = `${days}天${hours}小时`;
    } else {
      const lastOnline = await db.prepare(`
        SELECT timestamp FROM tunnel_history 
        WHERE name = ? AND online = 1 
        ORDER BY timestamp DESC LIMIT 1
      `).bind(name).first();

      if (!lastOnline) {
        isZeroMinOffline = true;
      } else {
        const offDiffMs = Math.max(0, now - lastOnline.timestamp);
        const offTotalMin = Math.floor(offDiffMs / (1000 * 60));
        if (offTotalMin === 0) isZeroMinOffline = true;
        const offHours = Math.floor(offTotalMin / 60);
        const offMin = offTotalMin % 60;
        offlineDurationText = offHours > 0 ? `${offHours}小时${offMin}分钟` : `${offMin}分钟`;
      }
    }

    const twentyFourHoursAgo = now - 24 * 60 * 60 * 1000;
    const recentHistory = await db.prepare(`
      SELECT online, timestamp FROM tunnel_history 
      WHERE name = ? AND timestamp >= ? 
      ORDER BY timestamp ASC
    `).bind(name, twentyFourHoursAgo).all();

    const hourlyDots = [];
    const currentHourStart = new Date().setMinutes(0, 0, 0);

    for (let i = 23; i >= 0; i--) {
      const slotStart = currentHourStart - i * 3600 * 1000;
      const slotEnd = slotStart + 3600 * 1000;
      const recordsInSlot = (recentHistory.results || []).filter(r => r.timestamp >= slotStart && r.timestamp < slotEnd);

      if (recordsInSlot.length === 0) {
        hourlyDots.push("⚪");
      } else {
        const offlineCount = recordsInSlot.filter(r => r.online === 0).length;
        if (offlineCount > 10) {
          hourlyDots.push("🔴");
        } else if (offlineCount >= 5) {
          hourlyDots.push("🟡");
        } else {
          hourlyDots.push("🟢");
        }
      }
    }

    const thirtyDaysAgo = now - 30 * 24 * 60 * 60 * 1000;
    const monthHistory = await db.prepare(`
      SELECT online, timestamp FROM tunnel_history 
      WHERE name = ? AND timestamp >= ? 
      ORDER BY timestamp ASC
    `).bind(name, thirtyDaysAgo).all();

    const mRecords = monthHistory.results || [];
    let offlineIncidents = 0;
    let offlineMinutes = 0;
    let inOfflineState = false;

    for (let i = 0; i < mRecords.length; i++) {
      if (mRecords[i].online === 0) {
        offlineMinutes++;
        if (!inOfflineState) {
          offlineIncidents++;
          inOfflineState = true;
        }
      } else {
        inOfflineState = false;
      }
    }

    const totalMonitoredMin = mRecords.length;
    const onlineMinutes = Math.max(0, totalMonitoredMin - offlineMinutes);
    
    return {
      healthyText,
      offlineDurationText,
      isZeroMinOffline,
      dots: hourlyDots,
      monthMetrics: {
        days: Math.floor(onlineMinutes / (60 * 24)),
        hours: Math.floor((onlineMinutes % (60 * 24)) / 60),
        incidents: offlineIncidents,
        offHours: Math.floor(offlineMinutes / 60),
        offMin: offlineMinutes % 60
      }
    };
  } catch (e) {
    return {
      healthyText: "0天0小时",
      offlineDurationText: "0分钟",
      isZeroMinOffline: true,
      dots: Array(24).fill("⚪"),
      monthMetrics: { days: 0, hours: 0, incidents: 0, offHours: 0, offMin: 0 }
    };
  }
}

