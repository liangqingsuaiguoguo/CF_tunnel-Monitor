<script>
let localToggleState = {};
let currentAdminPass = "";
let unlockedDomainsMap = null;
let currentItemsCache = [];
let allExpanded = false;
let isFetching = false;

try { localToggleState = JSON.parse(localStorage.getItem("monitor_toggle") || "{}"); } catch(e) {}

function triggerRefresh() {
  if (currentItemsCache.length === 0) {
    alert("防呆提示：未检测到任何监控节点！\\n请前往 CF 控制台的环境变量设置 ARGO，或点击“配置隧道”添加监控节点。");
  }
  loadDataAndRender(true);
}

async function fetchWithTimeout(resource, options = {}) {
  const { timeout = 8000 } = options;
  const controller = new AbortController();
  const id = setTimeout(() => controller.abort(), timeout);
  try {
    const response = await fetch(resource, {
      ...options,
      signal: controller.signal
    });
    clearTimeout(id);
    return response;
  } catch (e) {
    clearTimeout(id);
    throw e;
  }
}

async function loadDataAndRender(isManual = false){
  if (isFetching) return;
  isFetching = true;

  if (isManual && currentItemsCache.length === 0) {
    document.getElementById("list").innerHTML = '<div class="skeleton"></div><div class="skeleton"></div>';
  }

  try {
    const r = await fetchWithTimeout("/status", { timeout: 8000 });
    const data = await r.json();
    
    currentItemsCache = data.items || [];
    document.getElementById("numTotal").innerText = data.total || 0;
    document.getElementById("numOnline").innerText = data.online || 0;
    document.getElementById("numOffline").innerText = data.offline || 0;

    let html = "";
    if(!data.items || data.items.length === 0){
      html = '<div style="padding:30px; text-align:center; color:var(--text-sub);">未检测到任何监控节点，请前往 CF 变量与机密或通过“配置隧道”进行添加。</div>';
    } else {
      data.items.forEach((v) => {
        const isShow = localToggleState[v.name] ?? true;
        const dotsHtml = v.dots.map(d => \`<div class="dot-item">\${d}</div>\`).join("");

        const realDomain = (unlockedDomainsMap && unlockedDomainsMap[v.name]) ? unlockedDomainsMap[v.name] : v.domain;
        const domainClass = unlockedDomainsMap ? "domain-clear" : "domain-mask";

        html += \`
          <div class="tunnel \${v.online ? 'online' : 'offline'}" id="tunnel_\${v.name}" data-online="\${v.online}">
            <div class="tunnel-header" onclick="toggleBody('\${v.name}')">
              <div class="tunnel-title-left">
                <h3>\${v.name} \${v.online ? '🟢' : '🔴'}</h3>
                <span class="\${domainClass}">\${realDomain}</span>
              </div>
              <div class="toggle-status" id="btn_\${v.name}">\${isShow ? '收起' : '展开'}</div>
            </div>
            <div class="tunnel-body \${isShow ? 'show' : ''}" id="body_\${v.name}">
              <div>
                当前状态：<span class="status-badge" style="background:\${v.online ? 'rgba(22,163,74,0.15);color:#16a34a' : 'rgba(220,38,38,0.15);color:#dc2626'}">\${v.online ? '正常运行' : '服务中断'}</span> 
                <span style="color:var(--text-sub);font-size:12px;margin-left:6px;">(HTTP Status: \${v.statusCode})</span>
              </div>
              
              \${v.online ? \`
                <div class="healthy-tag">
                  🛡️ 隧道已健康运行 \${v.healthyText}
                </div>
              \` : \`
                <div class="healthy-tag" style="color:#dc2626;background:rgba(220,38,38,0.1);">
                  ⚠️ 持续中断：\${v.isZeroMinOffline ? '该节点自纳入监控以来持续处于非活跃状态，请前往 Cloudflare Tunnel 控制台核查链路配置。' : v.offlineDurationText}
                </div>
              \`}

              <!-- 需求1：分行高亮格式改进 -->
              <div class="metrics-30d">
                📊 近30天中，隧道健康运行 <span class="green-text">\${v.monthMetrics.days}天\${v.monthMetrics.hours}小时</span><br>
                中断 <span class="red-text">\${v.monthMetrics.incidents}</span> 次，累计中断 <span class="red-text">\${v.monthMetrics.offHours}小时\${v.monthMetrics.offMin}分钟</span>
              </div>

              <!-- 需求2：修改文案为 24小时隧道监控 (00:00 - 24:00) -->
              <div class="dot-container-wrapper">
                <div class="dot-title"><span>24小时隧道监控 (00:00 - 24:00)</span><span>最近 &rarr;</span></div>
                <div class="dot-bar">\${dotsHtml}</div>
              </div>
            </div>
          </div>
        \`;
      });
    }
    document.getElementById("list").innerHTML = html;
  } catch(e) {
    if (currentItemsCache.length === 0) {
      document.getElementById("list").innerHTML = '<div style="color:#dc2626;padding:20px;text-align:center;">数据加载超时，请点击“刷新状态”重试</div>';
    }
  } finally {
    isFetching = false;
  }
}

function toggleAllCards(type) {
  if (currentItemsCache.length === 0) return;
  allExpanded = !allExpanded;
  currentItemsCache.forEach(item => {
    const body = document.getElementById("body_" + item.name);
    const btn = document.getElementById("btn_" + item.name);
    if (!body) return;

    let targetShow = false;
    if (type === 'all') {
      targetShow = allExpanded;
    } else if (type === 'online') {
      targetShow = item.online;
    } else if (type === 'offline') {
      targetShow = !item.online;
    }

    if (targetShow) {
      body.classList.add("show");
      btn.innerText = "收起";
      localToggleState[item.name] = true;
    } else {
      body.classList.remove("show");
      btn.innerText = "展开";
      localToggleState[item.name] = false;
    }
  });
  localStorage.setItem("monitor_toggle", JSON.stringify(localToggleState));
}

function toggleBody(name) {
  const body = document.getElementById("body_" + name);
  const btn = document.getElementById("btn_" + name);
  if (!body) return;
  const isShow = body.classList.contains("show");
  if (isShow) {
    body.classList.remove("show");
    btn.innerText = "展开";
    localToggleState[name] = false;
  } else {
    body.classList.add("show");
    btn.innerText = "收起";
    localToggleState[name] = true;
  }
  localStorage.setItem("monitor_toggle", JSON.stringify(localToggleState));
}

function handleTgPush() {
  const hasTg = ${hasTelegram};
  if (!hasTg) {
    document.getElementById("tgGuideModal").style.display = "flex";
  } else {
    pushStatus();
  }
}

function openConfigModal() { document.getElementById("configModal").style.display = "flex"; }
function closeConfigModal() { document.getElementById("configModal").style.display = "none"; }

async function verifyAndLoadConfig() {
  const pass = document.getElementById("adminPass").value;
  if (!pass) return alert("请输入密码");

  try {
    const res = await fetchWithTimeout("/api/get-config?pass=" + encodeURIComponent(pass));
    const data = await res.json();

    if (data.success) {
      currentAdminPass = pass;
      unlockedDomainsMap = {};
      
      document.getElementById("authSection").style.display = "none";
      document.getElementById("tableSection").style.display = "block";

      const tbody = document.getElementById("configTableBody");
      tbody.innerHTML = "";
      (data.tunnels || []).forEach(t => {
        unlockedDomainsMap[t.name] = t.domain;
        addTableRow(t.name, t.domain, t.isEnv);
      });

      loadDataAndRender();
    } else {
      alert("验证失败：" + data.error);
    }
  } catch(e) {
    alert("请求超时或网络异常");
  }
}

function addTableRow(name = "", domain = "", isEnv = false) {
  const tbody = document.getElementById("configTableBody");
  const tr = document.createElement("tr");
  
  if (isEnv) {
    tr.className = "locked-row";
    tr.innerHTML = \`
      <td style="text-align:center;font-size:11px;color:var(--text-sub);">🔒</td>
      <td><input type="text" class="t-name" value="\${name}" disabled style="cursor:not-allowed;opacity:0.7;"></td>
      <td><input type="text" class="t-domain" value="\${domain}" disabled style="cursor:not-allowed;opacity:0.7;"></td>
      <td style="text-align:center;font-size:11px;color:var(--text-sub);">环境变量锁定</td>
    \`;
  } else {
    tr.draggable = true;
    tr.innerHTML = \`
      <td><span class="drag-handle">☰</span></td>
      <td><input type="text" class="t-name" value="\${name}" placeholder="名称"></td>
      <td><input type="text" class="t-domain" value="\${domain}" placeholder="域名"></td>
      <td>
        <div class="action-cell">
          <button class="btn-move" onclick="moveRow(this, 'up')">⬆️</button>
          <button class="btn-move" onclick="moveRow(this, 'down')">⬇️</button>
          <button class="danger btn-delete" onclick="this.closest('tr').remove()">删除</button>
        </div>
      </td>
    \`;
    bindDragEvents(tr);
  }
  tbody.appendChild(tr);
}

function moveRow(btn, direction) {
  const row = btn.closest("tr");
  if (direction === 'up') {
    const prev = row.previousElementSibling;
    if (prev && !prev.classList.contains("locked-row")) {
      row.parentNode.insertBefore(row, prev);
    }
  } else if (direction === 'down') {
    const next = row.nextElementSibling;
    if (next) {
      row.parentNode.insertBefore(next, row);
    }
  }
}

function bindDragEvents(tr) {
  tr.addEventListener("dragstart", () => tr.classList.add("dragging"));
  tr.addEventListener("dragend", () => tr.classList.remove("dragging"));
}

document.getElementById("configTableBody").addEventListener("dragover", (e) => {
  e.preventDefault();
  const tbody = document.getElementById("configTableBody");
  const dragging = tbody.querySelector(".dragging");
  if (!dragging) return;
  const targetRow = e.target.closest("tr");
  if (targetRow && targetRow !== dragging && !targetRow.classList.contains("locked-row")) {
    const rect = targetRow.getBoundingClientRect();
    const next = (e.clientY - rect.top)/(rect.bottom - rect.top) > 0.5;
    tbody.insertBefore(dragging, next ? targetRow.nextSibling : targetRow);
  }
});

async function saveTableConfig() {
  const rows = document.querySelectorAll("#configTableBody tr:not(.locked-row)");
  const items = [];
  rows.forEach(tr => {
    const name = tr.querySelector(".t-name").value.trim();
    const domain = tr.querySelector(".t-domain").value.trim();
    if(name && domain) items.push({ name, domain });
  });

  try {
    const res = await fetch("/api/save-table-config", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({ pass: currentAdminPass, items })
    });
    const data = await res.json();
    if (data.success) {
      alert("保存成功！");
      closeConfigModal();
      unlockedDomainsMap = {};
      items.forEach(i => unlockedDomainsMap[i.name] = i.domain);
      loadDataAndRender();
    } else {
      alert("保存失败：" + data.error);
    }
  } catch(e) {
    alert("网络异常，保存失败");
  }
}

async function pushStatus(){
  const btn = document.getElementById("pushBtn");
  btn.innerText = "发送中...";
  try {
    const res = await fetch("/push-status", { method: "POST" });
    const result = await res.json();
    alert(result.success ? "已成功推送 Telegram" : "推送失败: " + result.error);
  } catch(e) {
    alert("网络异常");
  } finally {
    btn.innerText = "推送状态";
  }
}

loadDataAndRender();
setInterval(loadDataAndRender, 60000);
</script>
</body>
</html>`;
}

function maskDomain(domain) {
  if (!domain) return "";
  const parts = domain.split('.');
  if (parts.length <= 2) {
    return "***" + domain.slice(Math.floor(domain.length / 2));
  }
  return parts[0].slice(0, 2) + "***." + parts.slice(1).join('.');
}

// ========================================
// Worker 主入口与后端 API 路由分发
// ========================================
export default {
  async fetch(request, env, ctx) {
    if (env.DB) {
      await initDatabase(env.DB);
    }
    const config = getConfig(env);
    const url = new URL(request.url);

    // 1. 前端 HTML 渲染
    if (url.pathname === "/" || url.pathname === "/index.html") {
      const tunnels = await getMergedTunnels(env);
      const hasTelegram = Boolean(config.BOT_TOKEN && config.CHAT_ID);
      return new Response(getFrontendHTML(tunnels.length > 0, hasTelegram), {
        headers: { "content-type": "text/html;charset=UTF-8" }
      });
    }

    // 2. 状态获取 API
    if (url.pathname === "/status") {
      const tunnels = await getMergedTunnels(env);
      
      const resultItems = await Promise.all(tunnels.map(async (t) => {
        let statusRow = null;
        if (env.DB) {
          statusRow = await env.DB.prepare(`SELECT online, status_code FROM tunnel_status WHERE name = ?`).bind(t.name).first();
        }

        const isOnline = statusRow ? Boolean(statusRow.online) : false;
        const statusCode = statusRow ? statusRow.status_code : 0;

        let metrics = {
          healthyText: "0天0小时",
          offlineDurationText: "0分钟",
          isZeroMinOffline: true,
          dots: Array(24).fill("⚪"),
          monthMetrics: { days: 0, hours: 0, incidents: 0, offHours: 0, offMin: 0 }
        };

        if (env.DB) {
          metrics = await computeMetrics(env.DB, t.name, isOnline);
        }

        return {
          name: t.name,
          domain: maskDomain(t.domain),
          online: isOnline,
          statusCode: statusCode,
          ...metrics
        };
      }));

      const onlineCount = resultItems.filter(i => i.online).length;
      const offlineCount = resultItems.length - onlineCount;

      return new Response(JSON.stringify({
        total: tunnels.length,
        online: onlineCount,
        offline: offlineCount,
        items: resultItems
      }), { headers: { "content-type": "application/json" } });
    }

    // 3. 校验密码并获取完整配置
    if (url.pathname === "/api/get-config") {
      const pass = url.searchParams.get("pass");
      if (pass !== config.ADMIN_PASS) {
        return new Response(JSON.stringify({ success: false, error: "密码错误" }), { status: 403, headers: { "content-type": "application/json" } });
      }

      const tunnels = await getMergedTunnels(env);
      return new Response(JSON.stringify({ success: true, tunnels }), { headers: { "content-type": "application/json" } });
    }

    // 4. 保存 D1 表单配置
    if (url.pathname === "/api/save-table-config" && request.method === "POST") {
      try {
        const body = await request.json();
        if (body.pass !== config.ADMIN_PASS) {
          return new Response(JSON.stringify({ success: false, error: "密码错误" }), { status: 403, headers: { "content-type": "application/json" } });
        }

        if (!env.DB) {
          return new Response(JSON.stringify({ success: false, error: "未绑定 D1 数据库" }), { headers: { "content-type": "application/json" } });
        }

        await env.DB.prepare(`DELETE FROM tunnels_config`).run();

        const now = Date.now();
        for (const item of (body.items || [])) {
          await env.DB.prepare(`INSERT INTO tunnels_config (name, domain, created_at) VALUES (?, ?, ?)`).bind(item.name, item.domain, now).run();
        }

        return new Response(JSON.stringify({ success: true }), { headers: { "content-type": "application/json" } });
      } catch (e) {
        return new Response(JSON.stringify({ success: false, error: e.message }), { headers: { "content-type": "application/json" } });
      }
    }

    // 5. 需求3：手动 Telegram 推送 - 恢复全盘诊断报告排版格式
    if (url.pathname === "/push-status" && request.method === "POST") {
      const tunnels = await getMergedTunnels(env);
      if (tunnels.length === 0) {
        return new Response(JSON.stringify({ success: false, error: "无节点信息" }), { headers: { "content-type": "application/json" } });
      }

      let onlineCount = 0;
      let offlineCount = 0;
      const offlineDetails = [];

      for (const t of tunnels) {
        let statusRow = null;
        if (env.DB) {
          statusRow = await env.DB.prepare(`SELECT online, status_code FROM tunnel_status WHERE name = ?`).bind(t.name).first();
        }
        const isOnline = statusRow ? Boolean(statusRow.online) : false;
        
        if (isOnline) {
          onlineCount++;
        } else {
          offlineCount++;
          let metrics = { offlineDurationText: "0分钟", isZeroMinOffline: true };
          if (env.DB) {
            metrics = await computeMetrics(env.DB, t.name, false);
          }

          offlineDetails.push({
            name: t.name,
            domain: t.domain,
            isZeroMinOffline: metrics.isZeroMinOffline,
            offlineDurationText: metrics.offlineDurationText
          });
        }
      }

      let text = `📊 <b>Tunnel Monitor 节点全盘诊断报告</b>\n`;
      text += `━━━━━━━━━━━━━━━━━━\n`;
      text += `🌐 隧道总数：${tunnels.length} 个\n`;
      text += `🟢 正常运行：${onlineCount} 个\n`;
      text += `🔴 服务中断：${offlineCount} 个\n`;

      if (offlineCount > 0) {
        text += `\n⚠️ <b>故障中断节点明细：</b>\n\n`;
        offlineDetails.forEach((item) => {
          text += `• <b>${item.name}</b>\n`;
          text += `  🌐 节点域名：<code>${item.domain}</code>\n`;
          if (item.isZeroMinOffline) {
            text += `  ⏱️ 状态提示：该节点自纳入监控以来持续处于非活跃状态，请前往 Cloudflare Tunnel 控制台核查链路配置。\n\n`;
          } else {
            text += `  ⏱️ 持续中断：${item.offlineDurationText}\n\n`;
          }
        });
        text = text.trimEnd() + `\n`;
      }

      text += `━━━━━━━━━━━━━━━━━━\n`;
      text += `⏱️ 报告时间：${getBeijingTimeString()}`;

      const ok = await sendTelegram(env, text);
      return new Response(JSON.stringify({ success: ok, error: ok ? null : "推送失败，请查验 Telegram Token/Chat ID" }), { headers: { "content-type": "application/json" } });
    }

    return new Response("Not Found", { status: 404 });
  },

  // 6. Cron 定时计划任务入口
  async scheduled(event, env, ctx) {
    if (!env.DB) return;
    await initDatabase(env.DB);
    const tunnels = await getMergedTunnels(env);
    for (const tunnel of tunnels) {
      ctx.waitUntil(processTunnel(env, env.DB, tunnel));
    }
  }
};
